{
  "appId": "com.smartspend.expensetracker",
  "appName": "SmartSpend",
  "webDir": "www",
  "server": {
    "url": "https://orangered-sardine-855758.hostingersite.com",
    "cleartext": false,
    "allowNavigation": [
      "orangered-sardine-855758.hostingersite.com",
      "*.hostingersite.com",
      "cdn.jsdelivr.net",
      "cdnjs.cloudflare.com",
      "fonts.googleapis.com",
      "fonts.gstatic.com",
      "code.jquery.com"
    ]
  },
  "plugins": {
